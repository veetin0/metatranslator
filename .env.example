# Signer Core (copy to .env; see .hackforge/CONTRACTS.md §9)
SIGNER_HOST=0.0.0.0
SIGNER_PORT=8000
SIGNER_MODEL=knn
SIGNER_CONF_HIGH=0.80
SIGNER_CONF_LOW=0.50
SIGNER_IDLE_STOP_S=120
SIGNER_DATA_DIR=data
SIGNER_LLM=off
SIGNER_LLM_MODEL=claude-haiku-4-5-20251001
# Only gloss text is ever sent to Claude, and only when SIGNER_LLM=haiku
ANTHROPIC_API_KEY=
# Comma list of grafts to enable: teach,llm,question,reply_stt
SIGNER_FLAGS=
